<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Mint Wave</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- 백그라운드 오디오 — 화면 끄거나 다른 앱 띄워도 음악 계속 재생 (무디 핵심 기능) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- iTunes/Music 처럼 미디어 컨트롤 센터 + 잠금화면에 표시 -->
	<key>MPNowPlayingInfoCenterDelegate</key>
	<true/>
	<!-- 다른 앱 음악 재생 중일 때 무디 켜면 자동으로 다른 앱 음악 멈춤 (audio session category playback) -->
	<key>AVAudioSessionCategoryPlayback</key>
	<true/>
	<!-- App Transport Security — HTTPS 만 허용 (Apple 기본 권장) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<!-- 마이크/카메라 미사용 — 권한 요청 안 함. 추후 ASMR 녹음 등 필요 시 NSMicrophoneUsageDescription 추가 -->
	<!--
		Google Sign-In URL Scheme:
		아래 com.googleusercontent.apps.PLACEHOLDER 를 Google Cloud Console 에서
		받은 iOS Client ID 의 REVERSED CLIENT ID 로 바꿔야 함.
		예: iOS Client ID 가 634051967148-abc123.apps.googleusercontent.com 이면
		    Reversed ID 는 com.googleusercontent.apps.634051967148-abc123
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mintwave.app.googlesignin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.PLACEHOLDER</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
